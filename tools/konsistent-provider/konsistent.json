{
  "version": "v1",
  "conventionSources": {
    "ai-toolkit": "./dist/conventions.json"
  },
  "conventions": [
    {
      "name": "package-dir-must-have-required-files",
      "description": "Every package directory must contain a specific minimum set of files.",
      "paths": ["."],
      "must": [
        "ai-toolkit/package-must-have-package-and-docs-files",
        "ai-toolkit/package-must-have-index"
      ]
    },
    {
      "name": "provider-package-must-export-required-symbols",
      "description": "Every provider package must have specific files that export a specific set of symbols.",
      "paths": ["src/index.ts"],
      "must": [
        "ai-toolkit/provider-package-must-export-provider-creator-and-settings",
        "ai-toolkit/provider-package-must-export-instance-case-1",
        "ai-toolkit/provider-package-must-export-instance-case-2",
        "ai-toolkit/provider-file-must-export-provider-class-and-settings-type",
        "ai-toolkit/provider-file-must-export-provider-instance-case-1",
        "ai-toolkit/provider-file-must-export-provider-instance-case-2",
        {
          "use": "ai-toolkit/provider-model-file-must-export-model-class",
          "excludeFiles": ["${providerId}-video-model.ts"]
        },
        "ai-toolkit/provider-model-file-with-subtype-must-export-model-class",
        "ai-toolkit/provider-video-model-file-must-export-model-class",
        {
          "use": "ai-toolkit/provider-model-file-must-have-matching-model-options-file",
          "excludeFiles": ["${providerId}-video-model.ts"]
        },
        "ai-toolkit/provider-model-file-with-subtype-must-have-matching-model-options-file",
        "ai-toolkit/provider-video-model-file-must-have-matching-model-options-file",
        "ai-toolkit/provider-language-model-file-must-import-workflow-serialization",
        "ai-toolkit/provider-model-options-file-must-export-model-options-type",
        "ai-toolkit/provider-model-options-file-with-subtype-must-export-model-options-type"
      ]
    }
  ]
}

{
  "name": "@ai-toolkit/sandbox-khulnasoft",
  "version": "2.0.1",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "files": [
    "dist/**/*",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts",
    "!src/**/__snapshots__",
    "!src/**/__fixtures__",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm clean && tsdown",
    "build:watch": "pnpm clean && tsdown --watch",
    "clean": "del-cli *.tsbuildinfo",
    "type-check": "tsc --build",
    "test": "pnpm test:node",
    "test:watch": "vitest --config vitest.node.config.js",
    "test:node": "vitest --config vitest.node.config.js --run"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@ai-toolkit/harness": "workspace:*",
    "@ai-toolkit/provider-utils": "workspace:*",
    "@khulnasoft/sandbox": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@khulnasoft/ai-tsconfig": "workspace:*",
    "tsdown": "^0.23.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://ai-toolkit.dev/docs",
  "repository": {
    "type": "git",
    "url": "https://github.com/khulnasoft/ai",
    "directory": "packages/sandbox-khulnasoft"
  },
  "bugs": {
    "url": "https://github.com/khulnasoft/ai/issues"
  },
  "keywords": [
    "ai",
    "sandbox",
    "khulnasoft"
  ]
}

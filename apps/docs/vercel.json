{
  "$schema": "https://openapi.khulnasoft.sh/khulnasoft.json",
  "buildCommand": "pnpm build:site",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "v5.ai-toolkit.dev" }],
      "destination": "https://ai-toolkit.dev/v5",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "v5.ai-toolkit.dev" }],
      "destination": "https://ai-toolkit.dev/v5/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "v6.ai-toolkit.dev" }],
      "destination": "https://ai-toolkit.dev/v6",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "v6.ai-toolkit.dev" }],
      "destination": "https://ai-toolkit.dev/v6/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "v7.ai-toolkit.dev" }],
      "destination": "https://ai-toolkit.dev/docs/introduction",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "v7.ai-toolkit.dev" }],
      "destination": "https://ai-toolkit.dev/:path*",
      "permanent": true
    }
  ],
  "git": {
    "deploymentEnabled": {
      "release-v*": false,
      "changeset-release/release-v*": false,
      "changesets-ghcommit-temp/**": false,
      "backport-pr-*": false
    }
  }
}
